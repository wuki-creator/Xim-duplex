# Set these in your terminal environment. This file is documentation, not auto-loaded.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=8788
ASR_URL=http://127.0.0.1:8791
ASR_ENGINE=windows
# ASR_ENGINE=whisper uses faster-whisper instead. Windows mode needs installed zh-CN speech.
# ASR_POWERSHELL can select an installed PowerShell 7 executable; do not change security policies.
# Whisper model name or an existing local model directory
ASR_MODEL=tiny
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Optional JSON file outside the repository containing {"api_key":"your key"}
XIM_CONFIG=
# Optional: enables the selectable MOSS-Live voice mode. Existing basic voice remains the default.
MOSS_API_KEY=
# Set MOSS_LIVE=0 to hide the realtime cloud route.
MOSS_LIVE=
# Choose moss for Nex language generation; omit to keep DeepSeek.
XIM_CHAT_PROVIDER=
# Optional: moss-transcribe-1.0 or moss-transcribe-diarize-pro; omitted keeps Whisper.
MOSS_ASR_MODEL=
# Different providers may expose different voice IDs; confirm each in the MOSS console.
MOSS_TTS_VOICE_ID=
MOSS_LIVE_VOICE_ID=
