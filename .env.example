# Set these in your terminal environment. This file is documentation, not auto-loaded.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=8788
ASR_URL=http://127.0.0.1:8791
ASR_ENGINE=windows
# ASR_ENGINE=whisper uses faster-whisper instead. Windows mode needs installed zh-CN speech.
# ASR_POWERSHELL can select an installed PowerShell 7 executable; do not change security policies.
# Whisper model name or an existing local model directory
ASR_MODEL=tiny
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Optional JSON file outside the repository containing {"api_key":"your key"}
XIM_CONFIG=
