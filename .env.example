# Set environment variables in your terminal. This file is documentation, not auto-loaded.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=8788
# Self-hosted ASR, local or forwarded over SSH; loopback only.
ASR_URL=http://127.0.0.1:8791
ASR_ENGINE=windows
# ASR_ENGINE=whisper selects faster-whisper. Windows mode needs installed zh-CN speech.
ASR_MODEL=tiny
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Optional private JSON outside this repository, containing api_key.
XIM_CONFIG=
# Optional fixed-job physics worker, forwarded over SSH.
XIM_COMPUTE_URL=
# Local chat worker: POST /v1/chat/completions. Omit to use DeepSeek.
XIM_LOCAL_CHAT_URL=
XIM_LOCAL_CHAT_MODEL=
# Local speech worker: POST /v1/audio/speech returns bounded raw WAV.
# Omit both to use browser/device speech. No cloud voice fallback.
XIM_LOCAL_TTS_URL=
XIM_LOCAL_TTS_MODEL=
XIM_LOCAL_VOICE=default
# Local image worker: POST /v1/images/generations returns data[0].b64_json (PNG/JPEG).
# Omit both to show IMAGE_NOT_CONFIGURED; no remote-provider fallback.
XIM_LOCAL_IMAGE_URL=
XIM_LOCAL_IMAGE_MODEL=
